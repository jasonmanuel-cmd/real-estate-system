# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ca_deal_engine?schema=public"

# Server
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
MFA_ISSUER="CA Deal Engine"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ETL Configuration
ETL_SCHEDULE="0 2 * * *"  # Run at 2 AM daily
ETL_ENABLED=true

# Data Sources (Add API keys/credentials as needed)
KERN_COUNTY_DATA_SOURCE_URL=""
# Add other county data source URLs/credentials here

# Optional: Contact Enrichment (if enabled)
ENRICHMENT_API_KEY=""
ENRICHMENT_ENABLED=false
ENRICHMENT_MIN_SCORE=75

# Logging
LOG_LEVEL="info"

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN="http://localhost:3000"

# Audit
AUDIT_RETENTION_DAYS=365
