# Database (SQLite for local dev; see docker-compose.yml for Postgres)
DATABASE_URL="file:./dev.db"

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Auth - generate a real secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-minimum-32-characters-long"
JWT_EXPIRES_IN="7d"
MFA_ISSUER="CA Deal Engine"
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ETL / logging
ETL_SCHEDULE="0 2 * * *"
ETL_ENABLED=false
LOG_LEVEL=info

# Kern County data source (path is relative to backend/ when running npm scripts there)
KERN_COUNTY_DATA_FILE="../data/sample_kern_data.csv"
